# ==============================================================================
# OnBoarding Buddy - Environment Configuration Template
# ==============================================================================
# SECURITY & DEPLOYMENT INSTRUCTIONS:
#
# 1. LOCAL DEVELOPMENT:
#    - Copy this file to '.env' and populate your local keys:
#      cp .env.example .env
#    - The '.env' file is strictly for local dev and is excluded by .gitignore.
#
# 2. PRODUCTION DEPLOYMENT:
#    - DO NOT use or commit a '.env' file in production!
#    - Inject environment variables using your platform's secret manager or
#      runtime configuration (e.g. AWS Secrets Manager, Kubernetes Secrets,
#      Render, Railway, Fly.io, or Docker runtime environment).
#    - GROQ_API_KEY and DATABASE_URL MUST be stored as secure deployment secrets.
#    - Set ENVIRONMENT=production and DEBUG=false.
# ==============================================================================

# Application Environment ('development', 'production', or 'testing')
ENVIRONMENT=development

# Debug Mode
# MUST be set to 'false' in production to disable internal stack traces and auto-reload
DEBUG=false

# Server Network Configuration
# Use 127.0.0.1 for local dev, 0.0.0.0 for Docker containers and cloud platforms
HOST=127.0.0.1
PORT=8000

# Groq AI Service Secret (REQUIRED for AI features)
# In production, configure this as a deployment secret (never commit to git).
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Configuration
# Recommended Options:
#   - openai/gpt-oss-120b (High capability reasoning & architecture synthesis)
#   - openai/gpt-oss-20b  (Fast summaries & lightweight tasks)
#   - qwen/qwen3.8-27b    (Deep code synthesis)
GROQ_MODEL=openai/gpt-oss-120b

# PostgreSQL Database Configuration (Neon PostgreSQL recommended)
# In production, supply as a secure deployment secret:
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.neon.tech/neondb?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Production CORS Configuration (Comma-separated list of allowed origins)
# In production, restrict this strictly to your verified frontend domain(s):
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://onboarding-buddy.yourdomain.com
# In local development, defaults to localhost:3000, 127.0.0.1:8000, etc.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# API Interactive Documentation (/docs, /redoc, /openapi.json)
# Defaults to true in development, false in production unless explicitly set to true
ENABLE_DOCS=false

# Logging Level ('DEBUG', 'INFO', 'WARNING', 'ERROR')
LOG_LEVEL=INFO
